{
  "manifest_version": 3,
  "name": "ReelMind",
  "version": "0.2.1",
  "description": "Save videos to your private ReelMind library.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://vojkjssmapgvywgafrsn.supabase.co/*"
  ]
}